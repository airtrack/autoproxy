    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${datasource}"
      },
      "description": "Metrics: `autoproxy.proxy.connections` · Table: `otel_metrics_sum`",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "noValue": "0",
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${datasource}"
          },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT time,\n       pair.1 AS series,\n       sum(pair.2) OVER (PARTITION BY pair.1 ORDER BY time) AS connections\nFROM (\n    SELECT $__timeInterval(TimeUnix) AS time,\n           [('total', sum(delta)),\n            ('http', sumIf(delta, Attributes['protocol'] = 'http')),\n            ('socks5', sumIf(delta, Attributes['protocol'] = 'socks5'))] AS pairs\n    FROM (\n        SELECT TimeUnix,\n               Attributes,\n               greatest(Value - lagInFrame(Value, 1, Value)\n                        OVER (PARTITION BY MetricName, toString(Attributes) ORDER BY TimeUnix), 0) AS delta\n        FROM otel.otel_metrics_sum\n        WHERE MetricName = 'autoproxy.proxy.connections'\n          AND ServiceName = '${service}'\n    )\n    GROUP BY time\n)\nARRAY JOIN pairs AS pair\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Connections, total",
      "type": "timeseries"
    },
    {
