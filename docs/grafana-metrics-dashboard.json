      "description": "Metrics: `autoproxy.dns.queries` · Table: `otel_metrics_sum`",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisPlacement": "auto",
